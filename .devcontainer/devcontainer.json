{
  "name": "administration-enterprise-studio",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080, 17474, 17687, 27474, 27687, 37474, 37687, 47474, 47687, 57474, 57687],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "STUDIO_LINK.txt"]
    }
  },
  "postAttachCommand": "docker --version"
}
